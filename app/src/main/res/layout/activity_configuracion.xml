<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/botonRegresar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Regresar"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Ajustes y configuración"
            android:textColor="@color/Red"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/botonAccesibilidad"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/Red"
            android:text="Accesibilidad"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/botonCambiarContrasena"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/Red"
            android:text="Cambiar contraseña"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/botonContactanos"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/Red"
            android:text="Contáctanos"
            android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>